<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">

    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="30dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="32dp"
        android:layout_marginTop="128dp"
        android:layout_marginBottom="128dp"

        />
    <Button
        android:id="@+id/button_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/total"
        app:layout_constraintBottom_toTopOf="@+id/button_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_8"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"

    />
    <Button
        android:id="@+id/button_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/total"
        app:layout_constraintBottom_toTopOf="@+id/button_5"
        app:layout_constraintStart_toEndOf="@+id/button_7"
        app:layout_constraintEnd_toStartOf="@+id/button_9"
        android:layout_marginTop="32dp"
    />
    <Button
        android:id="@+id/button_9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/total"
        app:layout_constraintBottom_toTopOf="@+id/button_6"
        app:layout_constraintStart_toEndOf="@+id/button_8"
        app:layout_constraintEnd_toStartOf="@+id/button_par"
        android:layout_marginTop="32dp"
        />
    <Button
        android:id="@+id/button_par"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="÷"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/total"
        app:layout_constraintBottom_toTopOf="@+id/button_mix"
        app:layout_constraintStart_toEndOf="@+id/button_9"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"

        />
    <Button
        android:id="@+id/button_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="4"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_7"
        app:layout_constraintBottom_toTopOf="@+id/button_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_5"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        />
    <Button
        android:id="@+id/button_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_8"
        app:layout_constraintBottom_toTopOf="@+id/button_2"
        app:layout_constraintStart_toEndOf="@+id/button_4"
        app:layout_constraintEnd_toStartOf="@+id/button_6"
        android:layout_marginTop="32dp"
        />
    <Button
        android:id="@+id/button_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_9"
        app:layout_constraintBottom_toTopOf="@+id/button_3"
        app:layout_constraintStart_toEndOf="@+id/button_5"
        app:layout_constraintEnd_toStartOf="@+id/button_mix"
        android:layout_marginTop="32dp"
        />
    <Button
        android:id="@+id/button_mix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="×"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_par"
        app:layout_constraintBottom_toTopOf="@+id/button_minus"
        app:layout_constraintStart_toEndOf="@+id/button_6"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        />
    <Button
        android:id="@+id/button_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_4"
        app:layout_constraintBottom_toTopOf="@+id/button_ac"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_2"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        />
    <Button
        android:id="@+id/button_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_5"
        app:layout_constraintBottom_toTopOf="@+id/button_0"
        app:layout_constraintStart_toEndOf="@+id/button_1"
        app:layout_constraintEnd_toStartOf="@+id/button_3"
        android:layout_marginTop="32dp"
        />
    <Button
        android:id="@+id/button_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_6"
        app:layout_constraintBottom_toTopOf="@+id/button_equal"
        app:layout_constraintStart_toEndOf="@+id/button_2"
        app:layout_constraintEnd_toStartOf="@+id/button_minus"
        android:layout_marginTop="32dp"
        />
    <Button
        android:id="@+id/button_minus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_mix"
        app:layout_constraintBottom_toTopOf="@+id/button_plus"
        app:layout_constraintStart_toEndOf="@+id/button_3"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        />
    <Button
        android:id="@+id/button_ac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AC"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_0"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="256dp"
        />
    <Button
        android:id="@+id/button_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_ac"
        app:layout_constraintEnd_toStartOf="@+id/button_equal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="256dp"
        />
    <Button
        android:id="@+id/button_equal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="="
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_0"
        app:layout_constraintEnd_toStartOf="@+id/button_plus"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="256dp"
        />
    <Button
        android:id="@+id/button_plus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/button_minus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_equal"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="256dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>