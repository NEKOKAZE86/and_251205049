<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity6">
    <TextView
        android:id="@+id/label_transport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transport"
        android:layout_margin="16dp"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        />
    <TextView
        android:id="@+id/text_transport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WiFi"
        android:layout_marginStart="16dp"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="@+id/label_transport"
        app:layout_constraintStart_toEndOf="@id/label_transport"
        />
    <TextView
        android:id="@+id/label_ipaddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IPアドレス"
        android:textSize="20dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/label_transport"
        app:layout_constraintStart_toStartOf="parent"
        />
    <TextView
        android:id="@+id/text_ipaddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="192.168.100.100/24"
        android:textSize="18dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/label_ipaddress"
        app:layout_constraintStart_toStartOf="@id/label_ipaddress"
        />
    <Button
        android:id="@+id/retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RETRY"
        android:textSize="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="32dp"
    />
</androidx.constraintlayout.widget.ConstraintLayout>